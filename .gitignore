/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# local env files
.env*.local

# ICBC crawler runtime state
/data/icbc-products/.cookies/

# vercel
.vercel

# typescript
*.tsbuildinfo
next-env.d.ts

